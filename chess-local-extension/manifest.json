{
  "manifest_version": 3,
  "name": "Chess Local Dashboard",
  "version": "1.0.0",
  "description": "Panel de pestañas para monitorear ping, análisis y coach desde un backend local.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:4000/*"],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
